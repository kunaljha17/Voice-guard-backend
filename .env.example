# Port is automatically assigned by Render, default 5000 locally
PORT=5000

# MongoDB connection URI (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/voiceguard

# Secret key for JWT session tokens
JWT_SECRET=voiceguard_production_secret_key_change_me

# JWT token expiration window
JWT_EXPIRES_IN=7d

# Google Gemini API key for audio speech-to-text transcription
GEMINI_API_KEY=

# Deployed Remote ML Microservice URL (FastAPI / Cloud / Codespaces)
# Notice: Node backend forwards inference to this URL and does NOT need local .pt weights!
ML_SERVICE_URL=https://legendary-space-disco-5g7q7rpjrpq6cpp79-8000.app.github.dev
INFERENCE_URL=https://legendary-space-disco-5g7q7rpjrpq6cpp79-8000.app.github.dev
